{
  "name": "msgvault-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:kit-ui": "kit-ui-check src",
    "check:generated": "bun scripts/generate-api-client.mjs --check",
    "generate": "bun scripts/generate-api-client.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:e2e": "playwright test e2e conversation-content-frame.spec.ts files-viewer.spec.ts"
  },
  "dependencies": {
    "@kenn-io/kit-ui": "https://github.com/kenn-io/kit-ui/archive/b4227114b3f6cc5edaa9a7ebf6cab7dbec2f527e.tar.gz",
    "@lucide/svelte": "1.26.0",
    "@tanstack/svelte-virtual": "3.13.32",
    "dompurify": "3.4.11",
    "marked": "18.0.7",
    "pdfjs-dist": "5.4.296",
    "shiki": "4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.10.1",
    "es-module-lexer": "2.3.1",
    "jsdom": "29.1.1",
    "orval": "8.26.0",
    "postcss": "8.5.19",
    "prettier": "3.6.2",
    "svelte": "5.56.1",
    "svelte-check": "4.6.0",
    "typescript": "5.9.3",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
