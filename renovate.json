{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "timezone": "America/New_York",
  "dependencyDashboard": true,
  "enabledManagers": ["dockerfile", "github-actions", "gomod", "pep621"],
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "constraints": {
    "ghActionsLock": "v0.3.0"
  },
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "prCreation": "immediate",
    "schedule": ["at any time"]
  },
  "pep621": {
    "lockFileMaintenance": {
      "enabled": true
    }
  },
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Dockerfile dependencies",
      "groupSlug": "dockerfile-dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions dependencies",
      "groupSlug": "github-actions-dependencies",
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "separateMultipleMinor": false,
      "separateMultipleMajor": false
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "groupSlug": "go-dependencies",
      "postUpdateOptions": ["gomodUpdateImportPaths", "gomodTidy"]
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "Documentation dependencies",
      "groupSlug": "docs-dependencies"
    },
    {
      "description": ["kenn-io releases open right away: no release-age wait and no weekly window."],
      "matchPackageNames": ["kenn-io/**", "github.com/kenn-io/**", "go.kenn.io/**", "@kenn-io/**"],
      "groupName": "kenn-io dependencies",
      "groupSlug": "kenn-io-dependencies",
      "minimumReleaseAge": null,
      "schedule": ["at any time"]
    }
  ]
}
